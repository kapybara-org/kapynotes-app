/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// WinSparkle
//

// WinSparkle looks the update-signing public key up as a resource under
// exactly this name and type. It refuses any release whose DSA signature does
// not verify against it, so a hijacked feed cannot ship a payload. Replace the
// committed placeholder with the key printed by
// `dart run auto_updater:generate_keys`; while it is a placeholder every
// update is rejected, which is the correct way for this to fail.
DSAPub                  DSAPEM                  "resources\\dsa_pub.pem"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

// This is the string WinSparkle compares the appcast against. With nothing
// passed to win_sparkle_set_app_build_version it falls back to ProductVersion
// and reads it straight out of this resource.
//
// It must be the release triple and nothing else. Flutter's FLUTTER_VERSION
// carries pubspec's build metadata too, "1.4.0+5" rather than "1.4.0", and
// WinSparkle's comparator splits on character class, so "1.4.0+5" becomes
// 1 . 4 . 0 + 5 against the feed's 1 . 4 . 0. Equal as far as the shorter one
// goes, and the first part past it is "+", a string rather than a number, so
// it reads the extra segment as a pre-release marker and calls the installed
// build older: exactly the rule that puts 1.5b3 behind 1.5. The feed then
// offers a release that is already installed, forever, and every install
// hands back the same answer.
#if defined(FLUTTER_RELEASE_VERSION)
#define VERSION_AS_STRING FLUTTER_RELEASE_VERSION
#elif defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "com.kapybara" "\0"
            VALUE "FileDescription", "Kapy Notes" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "kapy_notes" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 com.kapybara. All rights reserved." "\0"
            VALUE "OriginalFilename", "kapy_notes.exe" "\0"
            VALUE "ProductName", "Kapy Notes" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
