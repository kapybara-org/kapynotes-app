<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Refreshing exchange rates needs the network. Flutter only adds this
         to the debug and profile manifests, so a release build without it
         fails every rate refresh. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Recording a voice note. Runtime-requested on first use, never at
         launch: a user who never records is never asked. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Requested only when the camera surface is opened. Choosing an
         existing photo uses Android's system Photo Picker and needs no broad
         storage permission. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Camera capture is useful but not required: tablets and emulators
         without one can still add pictures from their library. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <application
        android:label="Kapy Notes"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- A copied image stays in app cache and is exposed only through the
             temporary read grant ClipboardManager gives its receiving app. -->
        <provider
            android:name=".ClipboardImageProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The square widget, one action of the three. Not exported: the
             launcher and the keyguard bind widget providers through the
             system, and nothing else has any business broadcasting to this
             one. Its class name is the one it shipped as, for the reason
             given in WriteNoteWidget.kt. -->
        <receiver
            android:name=".WriteNoteWidget"
            android:exported="false"
            android:label="@string/widget_quick_action_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_action_info" />
        </receiver>
        <!-- The wide widget: all three actions at once. -->
        <receiver
            android:name=".QuickActionsWidget"
            android:exported="false"
            android:label="@string/widget_quick_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>
        <!-- Which action a square widget performs. Exported because the
             launcher starts it, which is the whole of what a widget
             configuration activity is; it is reachable no other way and does
             nothing but write one word into its own preferences. Kept out of
             Recents so that a question the Home Screen asked does not linger
             there as if it were the app. -->
        <activity
            android:name=".QuickActionConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_quick_action_label"
            android:theme="@style/WidgetConfigureTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher opens the exchange-rate attribution link. Under
             Android 11 package visibility it cannot see a browser without
             this, and the link silently does nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
