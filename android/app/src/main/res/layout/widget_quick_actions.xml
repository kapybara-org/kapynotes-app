<?xml version="1.0" encoding="utf-8"?>
<!-- Three cells of equal weight, each its own tap target, edge to edge with
     nothing boxed around them. The icons and words are set by
     QuickActionsWidget, in the order QuickAction declares them; what is here
     is what the launcher previews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_quick_actions_first"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_quick_actions_first_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_disc_primary"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_write_note"
            android:tint="@color/widget_on_primary" />

        <TextView
            android:id="@+id/widget_quick_actions_first_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="16sp"
            android:maxLines="1"
            android:text="@string/widget_action_write"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_quick_actions_second"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_quick_actions_second_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_disc_tonal"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_dictate"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/widget_quick_actions_second_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="16sp"
            android:maxLines="1"
            android:text="@string/widget_action_dictate"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_quick_actions_third"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_quick_actions_third_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_disc_tonal"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_capture"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/widget_quick_actions_third_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="16sp"
            android:maxLines="1"
            android:text="@string/widget_action_capture"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
