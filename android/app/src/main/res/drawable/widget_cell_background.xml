<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the wide widget. Faint rather than outlined: it says where a
     tap lands without turning the widget into three buttons in a box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_cell_corner_radius" />
    <solid android:color="@color/widget_cell" />
</shape>
