<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-bleed adaptive-icon field: the Fold mark's orange, so a circular
         or squircle OEM mask never exposes a different colour. -->
    <color name="ic_launcher_background">#E8772E</color>
    <color name="launch_background">#FAF9F7</color>
    <!-- The widgets wear Phone · v2, so a tap looks like the app it opens
         unfolding: its background and text, and its round sage buttons, one
         disc per tap. Write is on the primary disc everywhere; on the wide
         widget Dictate and Capture sit on the quieter tonal one. -->
    <color name="widget_background">#FCFAF4</color>
    <color name="widget_text">#2A2620</color>
    <color name="widget_primary">#56703C</color>
    <color name="widget_on_primary">#FCFAF4</color>
    <color name="widget_tonal">#E6ECDB</color>
    <color name="widget_on_tonal">#445A2F</color>
    <!-- A recording's notification: the clay the app records in, behind a
         white microphone. -->
    <color name="recording_clay">#CF7A57</color>
</resources>
