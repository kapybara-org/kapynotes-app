<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-bleed adaptive-icon field: the Fold mark's orange, so a circular
         or squircle OEM mask never exposes a different colour. -->
    <color name="ic_launcher_background">#E8772E</color>
    <color name="launch_background">#FAF9F7</color>
    <!-- The widgets wear the same paper and ink as the surface they open
         onto, so a tap looks like the app growing rather than replacing it.
         Matches InstantCaptureApp in lib/ui/instant_capture.dart. -->
    <color name="widget_paper">#F7F0DE</color>
    <color name="widget_ink">#26364A</color>
    <!-- Ink at a tenth, for the cells of the wide widget. -->
    <color name="widget_cell">#1A26364A</color>
</resources>
