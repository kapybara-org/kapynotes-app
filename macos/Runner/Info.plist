<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kapy Notes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- kapynotes://join/<token> and kapynotes://space/<token>, which the join
	     pages' "Open in Kapy Notes" button opens. Scheme only: universal links
	     would need an associated-domains entitlement, and a Developer ID build
	     carrying that without a matching provisioning profile will not launch. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.kapybara.kapynotes.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kapynotes</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Sparkle, driven by Runner/AppUpdater.swift. The feed URL is set in
	     Dart rather than here on purpose: the quiet daily check is our own,
	     and Sparkle is only pointed at the appcast once that check has found
	     a release to download. -->

	<!-- Sparkle refuses any release whose EdDSA signature does not verify
	     against this key, so a hijacked feed cannot ship a payload. Its private
	     half lives in the login keychain of whoever cut the release, and in the
	     SPARKLE_ED_PRIVATE_KEY repository secret. Print it again any time with
	     `macos/Pods/Sparkle/bin/generate_keys -p`. -->
	<key>SUPublicEDKey</key>
	<string>m/QEUYcH9j7ZJdgby5D1Kqr6utQlbe1EIUl/703mCt8=</string>

	<!-- The app is sandboxed, so it cannot replace its own bundle. This hands
	     installation to Sparkle's Installer XPC service, which runs outside
	     the sandbox. Paired with the two mach-lookup exceptions in
	     Runner/*.entitlements; remove one and updates fail at install time. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>

	<!-- Sparkle's own scheduler stays off. It checks against the standard user
	     driver, which puts its update panel on screen unprompted the moment it
	     finds a release — the interruption the whole design avoids. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<!-- But a check the app asks for downloads silently, and then hands the
	     app the one-click install. Sparkle only allows automatic downloads
	     while its own automatic checks are on, unless this says otherwise;
	     without it every download opens Sparkle's panel instead. When the
	     app asks is its own setting, "Download updates automatically". -->
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kapy Notes uses the microphone to record voice notes.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Kapy Notes turns your recordings into text on this device, without sending them anywhere.</string>
</dict>
</plist>
