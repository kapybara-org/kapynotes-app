# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Golden diffs written by a failing `flutter test`, useful locally and never
# worth committing.
/test/failures/

# Widget Preview related
.widget_preview/

# App Store Connect API key id/issuer for packaging/upload_ios.sh
packaging/.asc-credentials

# Android release signing. The keystore itself must be backed up somewhere
# durable: losing it means losing the ability to update the Play listing.
/android/key.properties
packaging/.play-credentials.json
*.jks
*.keystore
